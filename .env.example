# ============================================================
# QMS TESTNET & QWAP DAILY BOT CONFIGURATION
# (Catatan: Private Key dikelola di file wallets.json)
# ============================================================

# RPC and Network Settings
RPC_URL=https://rpc.testnet.qms.finance
CHAIN_ID=19480
EXPLORER_URL=https://testnet.qmsscan.io

# Role Boost
# Set to true if your Discord/account has Pioneer or Qwabbits role (earns 10 pts/day vs 8 pts/day)
IS_PIONEER_OR_QWABBIT=false

# Swap and Liquidity Amounts (in native QMS)
MIN_SWAP_AMOUNT=0.002
MAX_SWAP_AMOUNT=0.004
MIN_LP_ETH_AMOUNT=0.001
MAX_LP_ETH_AMOUNT=0.003

# Slippage tolerance in basis points (500 = 5%)
SLIPPAGE_BPS=500

# Anti-Sybil delays between wallets (in seconds)
MIN_DELAY_BETWEEN_WALLETS_SEC=15
MAX_DELAY_BETWEEN_WALLETS_SEC=45

# Cron Schedule for daemon mode (Default: runs every day at 00:15 UTC)
CRON_SCHEDULE="15 0 * * *"
